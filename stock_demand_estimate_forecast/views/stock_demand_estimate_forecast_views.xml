<odoo>
    <record id="stock_demand_estimate_forecast_view_list" model="ir.ui.view">
        <field name="name">stock.demand.estimate.forecast.list</field>
        <field name="model">stock.demand.estimate.forecast</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        name="action_generate_estimate"
                        type="object"
                        string="Generate Estimates"
                    />
                </header>
                <field name="product_id" />
                <field name="location_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="product_uom_qty" />
                <field name="product_uom" optional="hide" />
                <field name="generated" />
                <field name="estimate_id" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="stock_demand_estimate_forecast_view_form" model="ir.ui.view">
        <field name="name">stock.demand.estimate.forecast.form</field>
        <field name="model">stock.demand.estimate.forecast</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_estimate"
                        type="object"
                        string="Generate Estimate"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" />
                            <field name="location_id" />
                            <field name="product_uom_qty" />
                            <field name="product_uom" />
                        </group>
                        <group>
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="generated" />
                            <field name="estimate_id" readonly="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_demand_estimate_forecast_action" model="ir.actions.act_window">
        <field name="name">Demand Estimate Forecasts</field>
        <field name="res_model">stock.demand.estimate.forecast</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="stock_demand_estimate_forecast_menu"
        action="stock_demand_estimate_forecast_action"
        parent="stock_demand_estimate.stock_demand_planning_menu"
        sequence="20"
    />
</odoo>
